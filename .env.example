# Twilio WhatsApp
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# OpenAI
OPENAI_API_KEY=your_openai_key_here

PORT=3001

# Admin dashboard (GET /dashboard)
DASHBOARD_PASSWORD=admin123

# false = Twilio WhatsApp replies (ngrok + real phone)
# true  = JSON replies in POST /webhook (local curl tests)
WEBHOOK_RETURN_RESPONSES=false

# PostgreSQL — Supabase Session pooler (recommended for production)
# Dashboard → Project Settings → Database → Connection string → Session pooler → URI
# Username format: postgres.[PROJECT-REF]
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# Session store: auto | postgres | postgresql | json
SESSION_STORE=postgresql

# Local Postgres alternative (Docker): npm run db:up
# DATABASE_URL=postgresql://oraculo:oraculo@localhost:5432/oraculo_andino

# JSON fallback (dev only): SESSION_STORE=json
