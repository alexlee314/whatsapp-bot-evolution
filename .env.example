# Twilio WhatsApp
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Show WhatsApp "typing..." while preparing a reply (Twilio public beta)
TWILIO_TYPING_INDICATOR=true
# Minimum time typing stays visible before the reply (ms)
TWILIO_TYPING_MIN_MS=1200

# OpenAI
OPENAI_API_KEY=your_openai_key_here
# gpt-4o-mini is faster for birth-date extraction; gpt-4o for paid chat
OPENAI_BIRTH_DATE_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o
# Reply length caps (GPT max_tokens). Defaults: paid 550, free funnel 380
# OPENAI_PAID_CHAT_MAX_TOKENS=550
# OPENAI_FUNNEL_MAX_TOKENS=380
# Free funnel chat: true = GPT (uses ONLY oan_fin.json + instruction-oan-behavior.txt)
# false = code templates only (same two docs, no GPT)
FREE_FUNNEL_USE_GPT=true

PORT=3001

# Admin dashboard (GET /dashboard)
DASHBOARD_PASSWORD=admin123

# false = Twilio WhatsApp replies (ngrok + real phone)
# true  = JSON replies in POST /webhook (local curl tests)
WEBHOOK_RETURN_RESPONSES=false

# PostgreSQL — Supabase Session pooler (recommended for production)
# Dashboard → Project Settings → Database → Connection string → Session pooler → URI
# Username format: postgres.[PROJECT-REF]
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# Session store: auto | postgres | postgresql | json
SESSION_STORE=postgresql

# Local Postgres alternative (Docker): npm run db:up
# DATABASE_URL=postgresql://oraculo:oraculo@localhost:5432/oraculo_andino

# JSON fallback (dev only): SESSION_STORE=json

# Paid session timer (starts when Yape is validated). Default: 1800000 (30 minutes)
# SESSION_DURATION_MS=1800000
# Warning appended to replies in the last N minutes (default 5)
# SESSION_WARNING_MINUTES=5
