# Twilio WhatsApp
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# OpenAI
OPENAI_API_KEY=your_openai_key_here

PORT=3001

# Admin dashboard (GET /dashboard)
DASHBOARD_PASSWORD=admin123

# false = Twilio WhatsApp replies (ngrok + real phone)
# true  = JSON replies in POST /webhook (local curl tests)
WEBHOOK_RETURN_RESPONSES=false

# PostgreSQL (recommended for production)
# Local: docker compose up -d postgres
DATABASE_URL=postgresql://oraculo:oraculo@localhost:5432/oraculo_andino

# Session store: auto | postgres | json
# auto = postgres when DATABASE_URL is set, otherwise JSON file
SESSION_STORE=auto

# JSON fallback path (only when SESSION_STORE=json or auto without DATABASE_URL)
# DATABASE_PATH=backend/data/sessions.json
