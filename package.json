{
  "name": "whatsapp-bot-evolution",
  "version": "1.0.0",
  "description": "WhatsApp bot with Twilio, OCR payment validation and GPT-4 session",
  "main": "backend/src/index.js",
  "scripts": {
    "start": "node backend/src/index.js",
    "dev": "nodemon backend/src/index.js",
    "test": "node scripts/test-bot.js",
    "test:flow": "node scripts/simulate-flow.js",
    "test:payment-image": "node scripts/test-payment-image.js",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/db-migrate.js",
    "db:check": "node scripts/db-check.js",
    "db:import": "node scripts/import-sessions-json.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "openai": "^4.0.0",
    "pg": "^8.16.0",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
